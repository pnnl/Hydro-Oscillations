      <form name="Switched Mode Power Supply" splitter="60" w="420" h="400" commentlines="4" help-width="490">
        <category name="Configuration" visible="true" splitter="70">
          <cond><![CDATA[true]]></cond>
          <parameter name="Name" desc="Name" group="" type="Text" helpmode="Overwrite" allowemptystr="true" min="0" max="0">
            <value><![CDATA[]]></value>
            <cond><![CDATA[true]]></cond>
            <help><![CDATA[The name of the component]]></help>
            <regex><![CDATA[]]></regex>
            <error_msg><![CDATA[]]></error_msg>
            <vis />
          </parameter>
          <parameter name="Pnom" desc="Nominal Power Consumption, MW" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="MW" min="0.0015" max="0.0025">
            <value><![CDATA[0.002]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Vnom" desc="Nominal AC Voltage, kV RMS" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="0.1" max="1">
            <value><![CDATA[0.240]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="fcarr" desc="Switching Frequency, Hz" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="6000" max="1E+99">
            <value><![CDATA[65000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Cdc" desc="DC Link Capacitance, uF" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="uF" min="1" max="1E+308">
            <value><![CDATA[2000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Lin" desc="Boost Converter Inductance" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="H" min="1E-06" max="1E+308">
            <value><![CDATA[0.005]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Tfilt" desc="Measurement Time Constant" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="s" min="1E-09" max="0.01">
            <value><![CDATA[1e-4]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Kp_vreg" desc="Volt. Reg., Prop Gain" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="1E-09" max="1E+308">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Ti_vreg" desc="Volt. Reg., Int. Time Constant" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="1E-09" max="1E+308">
            <value><![CDATA[0.1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Kp_ireg" desc="Curr. Reg., Prop Gain" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="-1E+308" max="1E+308">
            <value><![CDATA[3000]]></value>
