      <form name="Basic GFL IBR" splitter="60" w="595" h="472" commentlines="4" help-width="490" category-width="180">
        <category name="Ratings" visible="true" splitter="65">
          <cond><![CDATA[true]]></cond>
          <parameter name="Name" desc="Name" group="" type="Text" helpmode="Overwrite" allowemptystr="true" min="0" max="0">
            <value><![CDATA[]]></value>
            <cond><![CDATA[true]]></cond>
            <help><![CDATA[The name of the component]]></help>
            <regex><![CDATA[]]></regex>
            <error_msg><![CDATA[]]></error_msg>
            <vis />
          </parameter>
          <parameter name="Snom" desc="Nominal Apparent Power, MVA" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="MVA" min="0.01" max="1E+308">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Vnom" desc="Nominal L-L RMS Voltage, kV" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="0.1" max="1E+308">
            <value><![CDATA[0.480]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="fnom" desc="Nominal AC Frequency, Hz" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="Hz" min="45" max="65">
            <value><![CDATA[60]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Vdcnom" desc="Nominal DC Link Voltage, kV" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="0.5" max="1E+308">
            <value><![CDATA[1.2]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="ilim" desc="AC Current Limit, pu" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0.9" max="1E+308">
            <value><![CDATA[1.25]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Cdc" desc="DC Link Capacitance, uF" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="uF" min="1" max="1E+308">
            <value><![CDATA[10000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Lpu" desc="AC Side Inductance, pu" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0.0001" max="1E+308">
            <value><![CDATA[0.2]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Tinit" desc="Startup Time Delay, s" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="s" min="0.001" max="1E+308">
            <value><![CDATA[0.25]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
        <category name="Controller Parameters" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="Kp_ireg" desc="Current Regulator, Proportional Gain, pu" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[0.5]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Ti_ireg" desc="Current Reg., Integral Time Constant, pu" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[0.2]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="dIref_max" desc="Current Ref., Max Rate of Change, pu/s" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu/s" min="0" max="1E+308">
            <value><![CDATA[50]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Kp_vdcreg" desc="DC Volt. Reg., Prop Gain, pu" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[3.5]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Ti_vdcreg" desc="DC Volt. Reg., Int Time Const., pu" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[0.005]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="iqctrl" desc="Reactive Power Control Method?" type="Choice" group="" helpmode="Append" animate="false">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
            <choice><![CDATA[0 = Unity PF]]></choice>
            <choice><![CDATA[1 = AC Voltage Reg.]]></choice>
          </parameter>
          <parameter name="Kp_reac" desc="React. Pow. Prop Gain, pu" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[2]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Ti_reac" desc="Reac. Pow. Int. Time Const, pu" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[0.05]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Vpu_MC" desc="Voltage Sag Threshold, pu" type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[0.7]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="EN_MC" desc="Enable Momentary Cessation?" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Enabling momentary cessation will cause the inverter to regulate its AC current to zero when the AC voltage drops below the voltage sag threshold]]></help>
          </parameter>
          <parameter name="EN_IFRZ" desc="Freeze Current Ref During Sags?" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="vsag_ipref" desc="Prefer Reac. Power During Voltage Sags?" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="" min="0" max="1">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[If enabled, current limiter will prioritize reactive power (q-axis) over real power (d-axis) when voltage is below sag threshold]]></help>
          </parameter>
          <parameter name="T_MC_in" desc="Momentary Cess. Pickup Tme Delay, s" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[0.01]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="T_MC_res" desc="Momentary Cess. Dropout Time Delay, s" type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[0.1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Time after voltage recovers (to above the pickup voltage) but before inverter leaves momentary cessation]]></help>
          </parameter>
          <parameter name="T_MC_walk" desc="Momentary Cess., Walk-In Time, s" type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[0.5]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[After voltage recovery and the dropout time delay passes, the Current Ref. Max Rate of Change is temporarily reduced to bring the AC current back up gradually over the walk-in time period]]></help>
          </parameter>
        </category>
      </form>
