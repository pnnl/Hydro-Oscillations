          </parameter>
          <parameter name="ov_byp_td" desc="Bypass Overvoltage Time Delay, s" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[0.005]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="en_byp_rec" desc="Enable Bypass Reconnection?" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="" min="-1E+308" max="1E+308">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="byp_rec_vtol" desc="Bypass Rec. Volt. Mag. Tolerance" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[0.05]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Reconnection occurs only if input voltage magnitude is within 1 pu + or -  this setting]]></help>
          </parameter>
          <parameter name="byp_rec_unbtol" desc="Bypass Rec. Volt. Unb. Tolerance" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[0.1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Reconnection only occurs if voltage unbalance below this threshold]]></help>
          </parameter>
          <parameter name="byp_rec_td" desc="Bypass Reconnection Time Delay, s" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[10]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
