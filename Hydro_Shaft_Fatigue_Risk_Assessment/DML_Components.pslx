        <Sticky classid="Sticky" id="1696820339" x="414" y="18" w="450" h="144" colors="0, 15792890">
          <paramlist>
            <param name="full_font" value="Tahoma, 12world" />
            <param name="align" value="0" />
            <param name="fg_color_adv" value="#FF000000" />
            <param name="bg_color_adv" value="#FFFAFAF0" />
            <param name="hl_color_adv" value="#FFFFFF00" />
            <param name="bdr_color_adv" value="#FF505050" />
            <param name="arrows" value="0" />
            <param name="style" value="1" />
            <param name="font" value="1" />
            <param name="fg_color" value="0" />
            <param name="bg_color" value="15792890" />
          </paramlist><![CDATA[Key control bit meanings:
EN - External enable signal for the VSC; VSC is open-circuit when this is 0
Start - Release control loops and end initialization stage
Rst - Reset all control loops to prepare for a start/restart
SAG - AC-side voltage sag is present, triggers UVRT-related controls
MC - Momentary cessation--turn the inverter off, it will restart once MC goes low
FRZ - Freeze the current references to a constant value 
WALKIN - After MC ends, limit the current ramp rate to a lower value for a time]]></Sticky>
