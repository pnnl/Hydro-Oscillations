    <Definition classid="UserCmpDefn" name="DC_bi_avm" group="" url="" version="" build="" crc="37973154" instances="1" key="" view="false" date="1764101653" id="1688837725">
      <paramlist>
        <param name="Description" value="DC-DC Buck-Boost Converter (AVM)" />
      </paramlist>
      <form name="DC-DC Buck-Boost Converter (SWM)" w="352" h="400" splitter="60" commentlines="4" help-width="490">
        <category name="Parameters" visible="true" splitter="66">
          <cond />
          <parameter desc="Converter On/Off [On:1; Off:0)" name="Dblk" group="General" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Rated Power, MW" name="Prate" group="General" unit="MW" min="-1E+308" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Power set-point, pu" name="Pref" group="General" unit="MW" min="-1E+308" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter name="Vnom" desc="Nominal Output Voltage, kV" type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="kV" min="0" max="1E+308">
