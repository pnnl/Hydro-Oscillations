          <parameter name="vnom" desc="Nominal AC Voltage, kV L-L RMS" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="0" max="1E+308">
            <value><![CDATA[0.480]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="vtype" desc="Protected Voltage (0=LN, 1=LL)" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Operating quantity for the voltage protection elements]]></help>
          </parameter>
          <parameter name="en_unb" desc="Enable Voltage Unbalance Protection?" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Tst" desc="Startup Time, s" type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+99">
            <value><![CDATA[0.25]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Tripping disabled before this time.]]></help>
