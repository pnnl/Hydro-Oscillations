      <form name="Contactor" splitter="60" w="456" h="400" commentlines="4" help-width="490">
        <category name="Configuration" visible="true" splitter="67">
          <cond><![CDATA[true]]></cond>
          <parameter name="Name" desc="Name" group="" type="Text" helpmode="Overwrite" allowemptystr="true" min="0" max="0">
            <value><![CDATA[]]></value>
            <cond><![CDATA[true]]></cond>
            <help><![CDATA[The name of the component]]></help>
            <regex><![CDATA[]]></regex>
            <error_msg><![CDATA[]]></error_msg>
            <vis />
          </parameter>
          <parameter name="vnom" desc="Nominal AC Voltage, kV RMS" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="0" max="1E+308">
            <value><![CDATA[0.277]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="vtype" desc="Protected Voltage (0=LG, 1=LN)" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Operating quantity for the voltage protection elements]]></help>
          </parameter>
          <parameter name="Tst" desc="Startup Time, s" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+99">
            <value><![CDATA[0.25]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Tripping disabled before this time.]]></help>
          </parameter>
          <parameter name="fnom" desc="Nominal Frequency, Hz" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="Hz" min="0" max="1E+308">
            <value><![CDATA[60]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Used for RMS calculation]]></help>
          </parameter>
          <parameter name="uv_pu" desc="Undervoltage Trip, Pickup Threshold, pu" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1">
            <value><![CDATA[0.75]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="T_uv" desc="Undervoltage Trip, Pickup Time, s" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[0.25]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
