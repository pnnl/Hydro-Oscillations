      <form name="UPS Controller" splitter="60" w="613" h="492" commentlines="4" help-width="490" category-width="180">
        <category name="Configuration" visible="true" splitter="60">
          <cond><![CDATA[true]]></cond>
          <parameter name="Name" desc="Name" group="" type="Text" helpmode="Overwrite" allowemptystr="true" min="0" max="0">
            <value><![CDATA[]]></value>
            <cond><![CDATA[true]]></cond>
            <help><![CDATA[The name of the component]]></help>
            <regex><![CDATA[]]></regex>
            <error_msg><![CDATA[]]></error_msg>
            <vis />
          </parameter>
          <parameter name="Vnom" desc="Nominal AC Voltage, kV L-L RMS" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="kV" min="0" max="1E+308">
            <value><![CDATA[0.480]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Snom" desc="Nominal Apparent Power, MVA" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="MVA" min="0" max="1E+308">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Fnom" desc="Nominal AC Frequency, Hz" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="Hz" min="0" max="1E+308">
            <value><![CDATA[60]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="mode_init" desc="Initial Operating Mode" type="Choice" group="" helpmode="Append" animate="false">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
            <choice><![CDATA[0 = Normal]]></choice>
            <choice><![CDATA[1 = Bypass]]></choice>
            <choice><![CDATA[2 = Battery]]></choice>
          </parameter>
          <parameter name="Ts" desc="Startup Time, s" type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[0.25]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Controls hold in initial operating mode until this time passes]]></help>
          </parameter>
        </category>
        <category name="Bypass Mode Controls" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="en_uv_byp" desc="Enable AC Bypass Undervoltage?" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="" min="0" max="1">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="uv_byp_pu" desc="Bypass Undervoltage Pickup, pu" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1">
            <value><![CDATA[0.95]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="uv_byp_td" desc="Bypass Undervoltage Time Delay, s" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[0.005]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="en_unb_byp" desc="Enable Bypass Volt. Unbalance?" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="" min="0" max="1">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="unb_byp_pu" desc="Bypass Volt. Unbalance Pickup, pu" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[0.1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="unb_byp_td" desc="Bypass Volt. Unbalance, Time Delay, s" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[0.005]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="en_ov_byp" desc="Enable AC Bypass Overvoltage?" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="" min="0" max="1">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="ov_byp_pu" desc="Bypass Overvoltage Pickup, pu" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="pu" min="1" max="99">
            <value><![CDATA[1.05]]></value>
            <cond><![CDATA[true]]></cond>
