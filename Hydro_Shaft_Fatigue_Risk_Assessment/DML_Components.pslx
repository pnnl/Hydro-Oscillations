      <form name="Playback-Based AI Training Load" splitter="60" w="372" h="400" commentlines="4" help-width="490">
        <category name="Configuration" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="Name" desc="Name" group="" type="Text" helpmode="Overwrite" allowemptystr="true" min="0" max="0">
            <value><![CDATA[]]></value>
            <cond><![CDATA[true]]></cond>
            <help><![CDATA[The name of the component]]></help>
            <regex><![CDATA[]]></regex>
            <error_msg><![CDATA[]]></error_msg>
            <vis />
          </parameter>
          <parameter name="Pnom" desc="Nominal Active Power, MW" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="MW" min="0" max="1E+308">
            <value><![CDATA[100]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Vnom" desc="Nominal Voltage, L-L kV RMS" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="kV" min="0" max="1E+308">
            <value><![CDATA[230]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="fnom" desc="Nominal Frequency, Hz" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="Hz" min="0" max="1E+308">
            <value><![CDATA[60]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Imax_pu" desc="Current limit, pu" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[1.25]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Ti" desc="Current Source Time Constant, s" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[0.005]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="EN_UV" desc="Enable UV Cessation?" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="" min="0" max="1">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="UV_PU" desc="UV Cessation Pickup, pu" type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1">
            <value><![CDATA[0.5]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="UV_TPU" desc="UV Cessation Pickup Time Delay" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[0.05]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="UV_TDO" desc="UV Cessation Dropout Time Delay" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[0.1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="UV_TREC" desc="Post-UV Reconnection Ramp Time, s" type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="s" min="0.001" max="1E+308">
            <value><![CDATA[0.1]]></value>
